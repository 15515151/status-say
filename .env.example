# These values are read by the server only. Never use a VITE_ prefix for secrets.
BOT_API_BASE_URL=http://192.168.31.126:5332
BOT_API_KEY=replace-with-your-api-key
BOT_MODEL=xc
HOST=127.0.0.1
PORT=3001

# Guoba panel URL including its mount path; no /#/account or /api suffix.
# Current local TRSS-Yunzai configuration uses port 2536 and /guoba.
GUOBA_BASE_URL=http://192.168.31.126:2536/guoba
GUOBA_ACCOUNT=
GUOBA_PASSWORD=

# Optional: defaults to the origin of GUOBA_BASE_URL (same Yunzai listener).
# Set explicitly to an empty value to disable parse statistics.
# RCONSOLE_BASE_URL=http://192.168.31.126:2536

# Optional: only needed if the upstream group endpoint path or parameter name differs.
# RCONSOLE_GROUP_PATH=rconsole/api/parse-stats/group
# RCONSOLE_GROUP_PARAM=group_id

# Optional: defaults to the origin of GUOBA_BASE_URL for /api/emo/stats.
# Set explicitly to an empty value to disable group statistics.
# EMO_BASE_URL=http://192.168.31.126:2536

# Docker Compose only; application PORT above is for running Node directly.
DOCKER_PORT=3001
# Use 127.0.0.1 here when only a local reverse proxy should reach the container.
DOCKER_BIND_ADDRESS=0.0.0.0
# Quote secrets containing $ or # with single quotes for dotenv / Compose compatibility.

# Docker Compose only; empty means build the image locally from this directory.
# Set it to the image built by GitHub Actions to deploy without building:
# XIANGCAI_IMAGE=ghcr.io/15515151/status-say:latest
XIANGCAI_IMAGE=
